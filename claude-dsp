#!/usr/bin/env bash
export MSYS=enable_pcon
export CALLER_DIR="$(pwd -W 2>/dev/null || pwd)"

# 获取调用脚本原始路径
SOURCE="$0"

# 循环解析软链接，直到找到真实文件
while [ -L "$SOURCE" ]; do
    # 获取软链接指向的目标
    TARGET=$(readlink "$SOURCE")
    if [[ "$TARGET" != /* ]]; then
        # 相对路径软链接，拼接软链接所在目录
        SOURCE_DIR=$(dirname "$SOURCE")
        SOURCE="$SOURCE_DIR/$TARGET"
    else
        SOURCE="$TARGET"
    fi
done

# SOURCE 现在是真实物理文件绝对路径
REAL_SCRIPT="$SOURCE"
# 真实脚本所在目录
SCRIPT_DIR=$(dirname "$REAL_SCRIPT")
echo "$SCRIPT_DIR"


ROOT_DIR="$SCRIPT_DIR"

cd "$ROOT_DIR"

# Use passed env file or default to .env
ENV_FILE="${1:-.env}"
shift  # Remove the env file arg, pass remaining args to the script

echo -e "\033]0;${ROOT_DIR}\007"

# Auto-detect Windows (Git Bash/MSYS2/Cygwin)
IS_WINDOWS=false
if [[ "$OSTYPE" == msys* ]] || [[ "$OSTYPE" == cygwin* ]] || [[ -n "$WINDIR" ]] || [[ "$OSTYPE" == "win32" ]]; then
  IS_WINDOWS=true
fi

# On Windows, force recovery CLI mode because Ink TUI requires raw mode
# which is not supported on process.stdin in Git Bash/MSYS2/Cygwin
# User can explicitly set CLAUDE_CODE_FORCE_RECOVERY_CLI=0 to disable this


# Extra args for Windows
EXTRA_ARGS=()
if [[ "$IS_WINDOWS" == true ]]; then
  # Only add --no-stdin if NOT using -p/--print mode
  if [[ "$*" != *"--no-stdin"* ]]; then
    if [[ "$*" != *"-p "* ]] && [[ "$*" != *"--print "* ]] && [[ "$*" != "-p" ]] && [[ "$*" != "--print" ]]; then
      EXTRA_ARGS+=("--no-stdin")
    fi
  fi
fi

# Force recovery CLI (simple readline REPL, no Ink TUI)
if [[ "${CLAUDE_CODE_FORCE_RECOVERY_CLI:-0}" == "1" ]]; then
  exec bun --env-file="$ENV_FILE" ./src/localRecoveryCli.ts "${EXTRA_ARGS[@]}" "$@"
fi

# Default: full CLI with Ink TUI
exec bun --env-file="$ENV_FILE" ./src/entrypoints/cli.tsx --dangerously-skip-permissions "${EXTRA_ARGS[@]}" "$@"
