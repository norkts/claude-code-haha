#!/usr/bin/env bash

export CALLER_DIR="$(pwd -W 2>/dev/null || pwd)"

# 获取调用脚本原始路径
SOURCE="$0"

# 循环解析软链接，直到找到真实文件
while [ -L "$SOURCE" ]; do
    # 获取软链接指向的目标
    TARGET=$(readlink "$SOURCE")
    if [[ "$TARGET" != /* ]]; then
        # 相对路径软链接，拼接软链接所在目录
        SOURCE_DIR=$(dirname "$SOURCE")
        SOURCE="$SOURCE_DIR/$TARGET"
    else
        SOURCE="$TARGET"
    fi
done

# SOURCE 现在是真实物理文件绝对路径
REAL_SCRIPT="$SOURCE"
# 真实脚本所在目录
SCRIPT_DIR=$(dirname "$REAL_SCRIPT")
echo "$SCRIPT_DIR"


ROOT_DIR="$SCRIPT_DIR"

cd "$ROOT_DIR"

# Use passed env file or default to .env
ENV_FILE="${1:-.env}"
shift  # Remove the env file arg, pass remaining args to the script

echo -e '\033]0;${ROOT_DIR}\007'

# Auto-detect Windows (Git Bash/MSYS2/Cygwin) and add --no-stdin if not already present
SKIP_STDIN=""
if [[ "$OSTYPE" == msys* ]] || [[ "$OSTYPE" == cygwin* ]] || [[ -n "$WINDIR" ]] || [[ "$OSTYPE" == "win32" ]]; then
  # Check if --no-stdin is already in the arguments
  if [[ "$*" != *"--no-stdin"* ]]; then
    SKIP_STDIN="--no-stdin"
  fi
fi

# Force recovery CLI (simple readline REPL, no Ink TUI)
if [[ "${CLAUDE_CODE_FORCE_RECOVERY_CLI:-0}" == "1" ]]; then
  exec bun --env-file="$ENV_FILE" ./src/localRecoveryCli.ts $SKIP_STDIN "$@"
fi

# Default: full CLI with Ink TUI
exec bun --env-file="$ENV_FILE" ./src/entrypoints/cli.tsx --dangerously-skip-permissions $SKIP_STDIN "$@"
